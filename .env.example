# ==========================================
# Minecraft Autonomous AI Agent Configuration
# ==========================================

# --- Minecraft Server Connection ---
MC_SERVER_HOST=localhost
MC_SERVER_PORT=25565
MC_BOT_USERNAME=AI_Alex
MC_BOT_AUTH=offline
MC_BOT_VERSION=

# --- RCON Remote Admin (Optional) ---
RCON_ENABLED=false
RCON_HOST=localhost
RCON_PORT=25575
RCON_PASSWORD=

# --- AI Brain LLM Configuration ---
# Options: groq | gemini | local
AI_PROVIDER=groq
AI_MASTER_NAME=Player
AI_AUTONOMOUS_MODE=true
AI_AUTONOMOUS_INTERVAL=12

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local LLM (Ollama / LM Studio)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.2

# --- Web Dashboard Port ---
WEB_PORT=3000
